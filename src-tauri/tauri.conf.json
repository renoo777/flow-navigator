{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow Navigator",
  "version": "0.1.8",
  "identifier": "com.flownavigator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5191",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flow Navigator - 变量导航",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Flow Navigator - 变量导航",
    "longDescription": "把一张复杂的 SOP 流程图，按变量取值实时收敛成一条可执行路线。支持上下游链路追踪、画布搜索、命令面板、路线高亮与一键分享图导出。v0.1.1：内置「支持作者」面板（微信/支付宝收款码）。v0.1.4：内置自动更新（GitHub Releases 通道）。",
    "publisher": "ming.zhou",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMTY3RjNFRjhBRUNBN0MKUldSOHlxNzRQbjhXY0R4RHJhSm5jeFR2cU1xRVZ4aXN2MkhIK2wvbmRiWTRPKzJmVkxwWnVyV0EK",
      "endpoints": [
        "https://github.com/renoo777/flow-navigator/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/renoo777/flow-navigator/releases/latest/download/latest-mirror.json",
        "https://gh-proxy.com/https://github.com/renoo777/flow-navigator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
